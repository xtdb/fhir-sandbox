<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="5 seconds">
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- Same as XTDB -->
            <pattern>%d{HH:mm:ss} | %-5level %logger{36} | %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Level Options -->
    <!-- TRACE: Most verbose, shows all messages -->
    <!-- DEBUG: Shows debug messages and below -->
    <!-- INFO: Shows info messages and below -->
    <!-- WARN: Shows warning messages and below -->
    <!-- ERROR: Shows error messages only -->

    <!-- Set levels for different packages -->
    <logger name="com.example" level="DEBUG"/>
    <logger name="xtdb.fhir" level="DEBUG"/>
    <logger name="org.springframework" level="INFO"/>

    <!-- Set level for everything else (default) -->
    <!-- Console-only logging (container best practice) -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>