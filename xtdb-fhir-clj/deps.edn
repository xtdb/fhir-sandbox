{:paths ["src"]

 :deps
 {org.clojure/clojure {:mvn/version "1.12.4"}
  com.xtdb/xtdb-api {:mvn/version "2.1.0"}
  com.github.seancorfield/next.jdbc {:mvn/version "1.3.1086"}
  mount/mount {:mvn/version "0.1.23"}
  environ/environ {:mvn/version "1.2.0"}
  org.clojure/tools.logging {:mvn/version "1.3.0"}
  com.zaxxer/HikariCP {:mvn/version "5.1.0"}
  org.postgresql/postgresql {:mvn/version "42.7.3"}
  ch.qos.logback/logback-classic {:mvn/version "1.5.6"}
  net.logstash.logback/logstash-logback-encoder {:mvn/version "8.0"}}

 :mvn/repos
 {"clojars" {:url "https://repo.clojars.org/"}
  "xtdb-snapshots" {:url "https://s01.oss.sonatype.org/content/repositories/snapshots"}}

 :aliases
 {:dev
  {:extra-paths ["dev"]
   :extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}
                cider/cider-nrepl {:mvn/version "0.50.2"}}}

  :run
  {:main-opts ["-m" "xtdb.fhir.guardrails"]}

  :build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.12"}}
   :ns-default build}}}
