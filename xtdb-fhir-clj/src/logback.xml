<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <!-- Same as XTDB -->
      <pattern>%d{HH:mm:ss} | %-5level %logger{36} | %msg%n</pattern>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>

  <logger name="com.zaxxer.hikari" level="INFO"/>
</configuration>